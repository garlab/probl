# SET: what's the chance that a fresh 12-card hand contains no set?
# A full deck has 81 distinct cards: four attributes with three values each.
# Every hand is drawn uniformly without replacement from a fresh deck.

@mode sample(runs: 10_000, seed: 42)

# Encode number, color, shape and shading as four values from 0 to 2.
let cards = (0..<81).map(n -> [n mod 3, (n div 3) mod 3, (n div 9) mod 3, n div 27])
var deck = bag(cards)
let hand = deck.take(12)
# Stop checking triples as soon as a set is found.
report not hand.combinations(3).any(is_set) as "no set in 12 cards"

# Each attribute must be all the same or all different across the three cards.
fn is_set(cards) {
  let [a, b, c] = cards
  for attribute in 0..<4 {
    let same = a[attribute] == b[attribute] and b[attribute] == c[attribute]
    let different = a[attribute] != b[attribute] and a[attribute] != c[attribute] and b[attribute] != c[attribute]
    if not (same or different) { return false }
  }
  true
}

# The exact probability is 2,284,535,476,080 / 70,724,320,184,700 ≈ 3.23%.
# Inspired by https://eli.thegreenplace.net/2026/monte-carlo-simulations/

# ── Output (sampled; seed 42) ─────────────────────────────────────────────
# sample · 10,000 runs · seed 42
#
# no set in 12 cards    2.8% ± 0.2%
