# Blackjack from a single 52-card deck: one hand against the dealer. The
# player hits below 17 and on soft 17; the dealer stands on 17. Every card
# dealt changes the odds of the next, so the deck is part of the state.
#
# Stresses: state explosion (the deck keeps worlds apart), bags.

@mode enumerate

var deck = bag([2: 4, 3: 4, 4: 4, 5: 4, 6: 4, 7: 4, 8: 4, 9: 4, 10: 16, 11: 4])

# A hand: its total, and how many aces in it still count 11.
fn add(hand, card) {
  var total = hand.total + card
  var aces = hand.aces + if card == 11 { 1 } else { 0 }
  while total > 21 and aces > 0 {
    total -= 10
    aces -= 1
  }
  { total: total, aces: aces }
}

var player = { total: 0, aces: 0 }
var dealer = { total: 0, aces: 0 }
repeat 2 {
  let c ~ deck.take()
  player = add(player, c)
}
repeat 2 {
  let c ~ deck.take()
  dealer = add(dealer, c)
}
while player.total < 17 or (player.total == 17 and player.aces > 0) {
  let c ~ deck.take()
  player = add(player, c)
}
var result = -1
if player.total <= 21 {
  while dealer.total < 17 {
    let c ~ deck.take()
    dealer = add(dealer, c)
  }
  result = if dealer.total > 21 or player.total > dealer.total { 1 } else if player.total == dealer.total { 0 } else { -1 }
}
report result == 1 as "player wins"
report result == 0 as "push"
