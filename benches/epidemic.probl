# An epidemic in a town of 10,000 (a stochastic SIR model): every day, each
# susceptible person may catch it from those infected, and the infected
# recover. How many catch it, and how bad is the peak?
#
# Stresses: sampling with large counts drawn every day.

@mode sample(runs: 10_000, seed: 1)

let r0 ~ 1.5 to 3              # people each case infects
let days_sick ~ 5 to 10
let population = 10_000
var s = population - 10
var i = 10
var peak = 10
var peak_day = 0
for day in 1..200 {
  let p = 1 - exp(-r0 / days_sick * i / population)
  let infected ~ binomial(s, prob(p))
  let recovered ~ binomial(i, prob(1 / days_sick))
  s -= infected
  i += infected - recovered
  if i > peak {
    peak = i
    peak_day = day
  }
}
report population - s as "people infected"
report peak as "most people sick at once"
report peak_day as "day of the peak"
