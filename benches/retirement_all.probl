# The retirement example's model (examples/21_retirement.probl), with the
# article's 10,000 trials, reporting the balance, whether it's depleted and
# the constant-rate baseline every year: 303 groups over 100 years.
#
# Stresses: many keyed reports in every run, and a continuous value's
# summaries, which keep every distinct sampled balance.

@mode sample(runs: 10_000, seed: 42)

let years = 100
let withdrawal = 30_000
var balance = 1_000_000.0
var baseline = balance

for year in 0..years {
  if year > 0 {
    let r ~ normal(4%, 18%)
    let q ~ normal(2%, 1.5%)
    balance = max(0.0, balance * (1 + max(-99%, r)) / (1 + max(-99%, q)) - withdrawal)
    baseline = max(0.0, baseline * (1 + 4%) / (1 + 2%) - withdrawal)
  }
  report balance by year as "balance in today's dollars"
  report balance == 0 by year as "depleted by year"
  report baseline by year as "constant-rate baseline"
}
