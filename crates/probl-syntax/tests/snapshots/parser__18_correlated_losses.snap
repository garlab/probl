---
source: crates/probl-syntax/tests/parser.rs
expression: tree
---
(let shared_loss = (simulate (block (let common ~ (call bernoulli 2%)) (var total = 0) (repeat 3 (block (let local ~ (call bernoulli 1%)) (if (or common local) (block (+= total 100))))) total)))
(let site_risk = (+ 2% (* 98% 1%)))
(let independent_loss = (* 100 (call binomial 3 site_risk)))
(report (call mean shared_loss) as "mean loss with common hazard")
(report (call mean independent_loss) as "mean loss assuming independence")
(report (>= shared_loss 200) as "multiple sites hit with common hazard")
(report (>= independent_loss 200) as "multiple sites hit assuming independence")
(report (call quantile shared_loss 99%) as "99th percentile with common hazard")
(report (call quantile independent_loss 99%) as "99th percentile assuming independence")
(report (call mean (call max (- shared_loss 100) 0)) as "expected loss above reserve")
(report (call mean (call max (- independent_loss 100) 0)) as "expected excess assuming independence")
