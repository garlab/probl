---
source: crates/probl-syntax/tests/parser.rs
expression: tree
---
(@mode exact)
(let weather = (if 30% (block "rain") (block "sun")))
(report weather)
(report (>= 2d6 10) as "2d6 rolls 10+")
(report (>= (+ 1d20 5) 15) as "a +5 attack hits armour class 15")
(let die = 1d6)
(report (+ die die))
(let r ~ 1d6)
(report (+ r r))
(let rain = 30%)
(let late = 20%)
(report (and rain late))
(report (or rain late))
(let raining ~ rain)
(report (and raining raining))
(var rolls = 1)
(while (!= 1d6 6) (block (+= rolls 1)))
(report rolls as "rolls until a six")
(var pos = 0)
(repeat 1000 (block (+= pos (if 50% (block 1) (block (- 1))))))
(report pos as "random walk after 1,000 steps")
(let sick ~ 1%)
(let positive = (if sick (block 95%) (block 8%)))
(observe positive)
(report sick as "sick, given a positive test")
