---
source: crates/probl-syntax/tests/parser.rs
expression: tree
---
(@mode enumerate)
(enum Basis Rectilinear Diagonal)
(let bases = [Rectilinear Diagonal])
(fn measure (bit: int, written: Basis, measured: Basis) -> int (block (if (== measured written) (block (return bit))) (return (if 50% (block 0) (block 1)))))
(type Photon {kept: bool, bob_wrong: bool, eve_right: bool})
(fn photon (listening: prob) -> Photon (block (let bit ~ (call one_of [0 1])) (let alice ~ (call one_of bases)) (let bob ~ (call one_of bases)) (var sent = bit) (var basis = alice) (var eve_right = false) (if listening (block (let eve ~ (call one_of bases)) (= sent (call measure bit alice eve)) (= basis eve) (= eve_right (== sent bit)))) (let seen = (call measure sent basis bob)) (return (record Photon (kept (== alice bob)) (bob_wrong (!= seen bit)) (eve_right eve_right)))))
(fn kept (listening: prob) -> Photon (block (let p = (call photon listening)) (observe (. p kept)) (return p)))
(report (simulate (block (. (call photon 0%) kept))) as "photons kept for the key")
(report (simulate (block (. (call kept 0%) bob_wrong))) as "errors in the key, no one listening")
(report (simulate (block (. (call kept 100%) bob_wrong))) as "errors in the key, Eve measuring every photon")
(report (simulate (block (. (call kept 100%) eve_right))) as "bits of the key Eve has right")
(for share [0% 10% 50% 100%] (block (report (simulate (block (. (call kept share) bob_wrong))) by share as "errors in the key, by the share of photons Eve measures")))
(let error = (call P (simulate (block (. (call kept 100%) bob_wrong)))))
(for compared [1 5 10 20 30] (block (report (> (call binomial compared error) 0) by compared as "Eve is caught, by the bits compared")))
(for compared [0 5 10 20] (block (let listened = (simulate (block (let eve ~ (call bernoulli 10%)) (observe 0 from (call binomial compared (if eve (block error) (block 0%)))) eve))) (report listened by compared as "Eve was listening, by the bits that agreed")))
