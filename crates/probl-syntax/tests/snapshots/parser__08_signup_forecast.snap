---
source: crates/probl-syntax/tests/parser.rs
expression: tree
---
(@mode (call sample runs: 200000 seed: 7))
(type Day {day: date, visitors: int, signups: int})
(let pilot: list[Day] = (call read "data/pilot.csv"))
(let rate ~ (call beta 2 40))
(for day pilot (block (observe (. day signups) from (call binomial (. day visitors) (call prob rate)))))
(report (* rate 100) as "conversion rate (%)")
(let daily_visitors ~ (to 300 500))
(let next_month ~ (call binomial (call round (* 30 daily_visitors)) (call prob rate)))
(report next_month as "sign-ups next month")
(report (>= next_month 400) as "at least 400 sign-ups")
