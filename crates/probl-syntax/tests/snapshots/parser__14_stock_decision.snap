---
source: crates/probl-syntax/tests/parser.rs
expression: tree
---
(let demand_model = (call one_of [20: 25%, 40: 50%, 60: 25%]))
(let quantities = [20 40 60])
(fn profit (order, demand) (block (- (+ (* 10 (call min order demand)) (* 2 (call max (- order demand) 0))) (* 6 order))))
(var chosen = (index quantities 0))
(var best_expected = (call mean (simulate (block (let d ~ demand_model) (call profit chosen d)))))
(for quantity quantities (block (let expected = (call mean (simulate (block (let d ~ demand_model) (call profit quantity d))))) (if (> expected best_expected) (block (= chosen quantity) (= best_expected expected))) (report expected by quantity as "expected profit by order")))
(let perfect = (simulate (block (let d ~ demand_model) (call max (.map quantities (-> (q) (call profit q d)))))))
(report chosen as "order chosen before demand")
(report (- (call mean perfect) best_expected) as "value of perfect information")
(let demand ~ demand_model)
(let actual = (call profit chosen demand))
(report actual as "profit from chosen order")
(report (- actual (call profit 20 demand)) as "gain over ordering 20")
(report (- (call max (.map quantities (-> (q) (call profit q demand)))) actual) as "regret after demand")
