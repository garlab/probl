(@mode (call sample runs: 10000 seed: 19))
(let counts = [0 1 0 1 5 6 5 6])
(let visitors = 10)
(let rate ~ (call beta 1 1))
(for successes counts (block (observe successes from (call binomial visitors rate))))
(var replicated = [])
(repeat (call len counts) (block (let successes ~ (call binomial visitors rate)) (.push replicated successes)))
(fn spread (xs) (block (- (call maximum xs) (call minimum xs))))
(report (* rate 100) as "common conversion rate (%)")
(report (call sum replicated) as "sign-ups in a replicated pilot")
(report (call spread replicated) as "replicated range across days")
(report (>= (call spread replicated) (call spread counts)) as "replicated range at least observed")
