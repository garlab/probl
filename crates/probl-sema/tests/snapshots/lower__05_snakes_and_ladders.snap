fn#1 race () captures [jumps_4 <- global jumps]
  square_0 = 0    [live: square_0 jumps_4]
  turns_1 = 0    [live: square_0 turns_1 jumps_4]
  loop {    [live at head: square_0 turns_1 jumps_4]
    if (< square_0 100) {
