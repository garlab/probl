      roll_2 ~ 1d6    [live: square_0 turns_1 roll_2 jumps_4]
      target_3 = (+ square_0 roll_2)    [live: square_0 turns_1 target_3 jumps_4]
      if (<= target_3 100) {
        square_0 = get(jumps_4, target_3, target_3)    [live: square_0 turns_1 jumps_4]
      }
    } else {
      break    [live: square_0 turns_1 jumps_4]
    }
  }
  return turns_1    [live: ]
fn#2 a simulate block () captures [jumps_1 <- parent slot 0]
