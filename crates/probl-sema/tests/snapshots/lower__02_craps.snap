---
source: crates/probl-sema/tests/lower.rs
expression: ir(&src)
---
fn#0 the top level ()
  win_1 = false    [live: win_1]
  rolls_2 = 1    [live: win_1 rolls_2]
  come_out_0 ~ 2d6    [live: come_out_0 win_1 rolls_2]
  if (in come_out_0 [7, 11]) {
    win_1 = true    [live: win_1 rolls_2]
  } else {
    if (not in come_out_0 [2, 3, 12]) {
      loop {    [live at head: come_out_0 win_1 rolls_2]
        rolls_2 = (+ rolls_2 1)    [live: come_out_0 win_1 rolls_2]
        r_3 ~ 2d6    [live: come_out_0 win_1 rolls_2 r_3]
        if (== r_3 come_out_0) {
          win_1 = true    [live: win_1 rolls_2]
          break    [live: come_out_0 win_1 rolls_2 r_3]
        }
        if (== r_3 7) {
          break    [live: come_out_0 win_1 rolls_2]
        }
      }
    }
  }
  report win_1 as "win"    [live: rolls_2]
  report rolls_2 as "rolls per bet"    [live: ]
