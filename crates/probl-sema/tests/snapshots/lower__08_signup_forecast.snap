---
source: crates/probl-sema/tests/lower.rs
expression: ir(&src)
---
fn#0 the top level ()
  pilot_0 = [9, 6, 11, 7, 8, 12, 5, 9, 10, 7, 8, 11, 6, 9]    [live: pilot_0]
  rate_1 ~ beta(2, 40)    [live: pilot_0 rate_1]
  $2 = $iter_items(pilot_0)    [live: rate_1 $2]
  $3 = 0    [live: rate_1 $2 $3]
  loop {    [live at head: rate_1 $2 $3]
    if (>= $3 len($2)) {
      break    [live: rate_1 $2 $3]
    }
    signups_4 = $2[$3]    [live: rate_1 $2 $3 signups_4]
    $3 = (+ $3 1)    [live: rate_1 $2 $3 signups_4]
    observe signups_4 from binomial(250, rate_1)    [live: rate_1 $2 $3]
  }
  report (* rate_1 100) as "conversion rate (%)"    [live: rate_1]
  daily_visitors_5 ~ to(300, 500)    [live: rate_1 daily_visitors_5]
  next_month_6 ~ binomial(round((* 30 daily_visitors_5)), rate_1)    [live: next_month_6]
  report next_month_6 as "sign-ups next month"    [live: next_month_6]
  report (>= next_month_6 400) as "at least 400 sign-ups"    [live: ]
