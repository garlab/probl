---
source: crates/probl-sema/tests/lower.rs
expression: ir(&src)
---
fn#0 the top level ()
  deck_0 = bag([2: 4, 3: 4, 4: 4, 5: 4, 6: 4, 7: 4, 8: 4, 9: 4, 10: 16, 11: 4])    [live: deck_0]
  $1 = deck_0.take()    [live: deck_0 $1]
  up_2 = $1    [live: deck_0 up_2]
  total_3 = up_2    [live: deck_0 up_2 total_3]
  if (== up_2 11) {
    $4 = 1    [live: deck_0 up_2 total_3 $4]
  } else {
    $4 = 0    [live: deck_0 up_2 total_3 $4]
  }
  soft_aces_5 = $4    [live: deck_0 up_2 total_3 soft_aces_5]
  loop {    [live at head: deck_0 up_2 total_3 soft_aces_5]
    if (< total_3 17) {
      $6 = deck_0.take()    [live: deck_0 up_2 total_3 soft_aces_5 $6]
      card_7 = $6    [live: deck_0 up_2 total_3 soft_aces_5 card_7]
      total_3 = (+ total_3 card_7)    [live: deck_0 up_2 total_3 soft_aces_5 card_7]
      if (== card_7 11) {
        soft_aces_5 = (+ soft_aces_5 1)    [live: deck_0 up_2 total_3 soft_aces_5]
      }
      if (and (> total_3 21) (> soft_aces_5 0)) {
        total_3 = (- total_3 10)    [live: deck_0 up_2 total_3 soft_aces_5]
        soft_aces_5 = (- soft_aces_5 1)    [live: deck_0 up_2 total_3 soft_aces_5]
      }
    } else {
      break    [live: deck_0 up_2 total_3 soft_aces_5]
    }
  }
  if (> total_3 21) {
    $8 = "bust"    [live: up_2 total_3 $8]
  } else {
    $8 = str(total_3)    [live: up_2 total_3 $8]
  }
  result_9 = $8    [live: up_2 total_3 result_9]
  report result_9 by up_2 as "dealer's final hand, by up-card (11 = ace)"    [live: total_3]
  report (> total_3 21) as "dealer busts"    [live: ]
