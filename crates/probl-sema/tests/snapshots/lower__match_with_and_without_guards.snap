---
source: crates/probl-sema/tests/lower.rs
expression: "ir(\"enum Weather { Sun, Rain }\\n\\\n         let w ~ one_of([Sun, Rain])\\n\\\n         let mood = match w { Sun => 1, Rain => -1 }\\n\\\n         let n ~ d6\\n\\\n         let size = match n { 1 | 2 => \\\"small\\\", x if x > 4 => \\\"big\\\", _ => \\\"medium\\\" }\\n\\\n         report mood\\n\\\n         report size\")"
---
fn#0 the top level ()
  w_0 ~ one_of([Weather.Sun, Weather.Rain])    [live: w_0 $5]
  $2 = w_0    [live: $2 $5]
  if (== $2 Weather.Sun) {
    $1 = 1    [live: $1 $5]
  } else {
    if (== $2 Weather.Rain) {
      $1 = (- 1)    [live: $1 $5]
    } else {
      fail "no arm of this `match` matches the value of `w`"    [live: $1 $5]
    }
  }
  mood_3 = $1    [live: mood_3 $5]
  n_4 ~ 1d6    [live: mood_3 n_4 $5]
  $6 = n_4    [live: mood_3 $5 $6]
  $7 = 0%    [live: mood_3 $5 $6 $7]
  if (and (not $7) (or (== $6 1) (== $6 2))) {
    $7 = 100%    [live: mood_3 $6 $7]
    $5 = "small"    [live: mood_3 $5 $6 $7]
  }
  if (and (not $7) 100%) {
    x_8 = $6    [live: mood_3 $5 $7 x_8]
    if (> x_8 4) {
      $7 = 100%    [live: mood_3 $7]
      $5 = "big"    [live: mood_3 $5 $7]
    }
  }
  if (and (not $7) 100%) {
    $7 = 100%    [live: mood_3 $7]
    $5 = "medium"    [live: mood_3 $5 $7]
  }
  if (not $7) {
    fail "no arm of this `match` matches the value of `n`"    [live: mood_3 $5]
  }
  size_9 = $5    [live: mood_3 size_9]
  report mood_3 as "mood"    [live: size_9]
  report size_9 as "size"    [live: ]
