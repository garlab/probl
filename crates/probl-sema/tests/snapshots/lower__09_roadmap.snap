fn#1 ship_date (weeks_0) captures [start_1 <- global start, overhead_2 <- global overhead, holidays_3 <- global holidays]
  check weeks_0: float    [live: weeks_0 start_1 overhead_2 holidays_3]
  $4 = (+ start_1 days(round((* 7 (+ (* weeks_0 (+ 1 overhead_2)) holidays_3)))))    [live: $4]
