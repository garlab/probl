---
source: crates/probl-sema/tests/lower.rs
expression: ir(&src)
---
fn#0 the top level ()
  chance (value) {
    30% => {
      $0 = "rain"    [live: $0]
    }
    else => {
      $0 = "sun"    [live: $0]
    }
  }
  weather_1 = $0    [live: weather_1]
  report weather_1 as "weather"    [live: ]
  report (>= 2d6 10) as "2d6 rolls 10+"    [live: ]
  report (>= (+ 1d20 5) 15) as "a +5 attack hits armour class 15"    [live: ]
  die_2 = 1d6    [live: die_2]
  report (+ die_2 die_2) as "die + die"    [live: ]
  r_3 ~ 1d6    [live: r_3]
  report (+ r_3 r_3) as "r + r"    [live: ]
  rain_4 ~ bernoulli(30%)    [live: rain_4]
  late_5 ~ bernoulli(20%)    [live: rain_4 late_5]
  report (and rain_4 late_5) as "rain and late"    [live: rain_4 late_5]
  report (or rain_4 late_5) as "rain or late"    [live: rain_4]
  report (and rain_4 rain_4) as "rain and rain"    [live: ]
  rolls_6 = 1    [live: rolls_6]
  loop {    [live at head: rolls_6]
    face_7 ~ 1d6    [live: rolls_6 face_7]
    if (!= face_7 6) {
      rolls_6 = (+ rolls_6 1)    [live: rolls_6]
    } else {
      break    [live: rolls_6]
    }
  }
  report rolls_6 as "rolls until a six"    [live: ]
  pos_8 = 0    [live: pos_8]
  $9 = $repeat_count(1000)    [live: pos_8 $9]
  $10 = 0    [live: pos_8 $9 $10]
  loop (bounded) {    [live at head: pos_8 $9 $10]
    if (>= $10 $9) {
      break    [live: pos_8 $9 $10]
    }
    $10 = (+ $10 1)    [live: pos_8 $9 $10]
    chance (value) {
      50% => {
        $11 = 1    [live: pos_8 $9 $10 $11]
      }
      else => {
        $11 = (- 1)    [live: pos_8 $9 $10 $11]
      }
    }
    pos_8 = (+ pos_8 $11)    [live: pos_8 $9 $10]
  }
  report pos_8 as "random walk after 1,000 steps"    [live: ]
  diagnosis_12 = simulate fn#1 []    [live: diagnosis_12]
  report diagnosis_12 as "sick, given a positive test"    [live: ]
fn#1 a simulate block ()
  sick_0 ~ bernoulli(1%)    [live: sick_0]
  if sick_0 {
    $1 = 0.95    [live: sick_0 $1]
  } else {
    $1 = 0.08    [live: sick_0 $1]
  }
  observe true from bernoulli(prob($1))    [live: sick_0]
  return sick_0    [live: ]
