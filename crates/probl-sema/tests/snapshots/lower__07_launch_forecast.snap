---
source: crates/probl-sema/tests/lower.rs
expression: ir(&src)
---
fn#0 the top level ()
  price_0 = 49    [live: price_0]
  churn_1 ~ to(3%, 7%)    [live: price_0 churn_1]
  market_2 ~ one_of([Market.Boom: 20%, Market.Steady: 60%, Market.Slump: 20%])    [live: price_0 churn_1 market_2]
  signups_3 ~ to(60, 150)    [live: price_0 churn_1 market_2 signups_3]
  customers_4 = 0    [live: price_0 churn_1 market_2 signups_3 customers_4]
  $5 = $iter_items((.. 1 18))    [live: price_0 churn_1 market_2 signups_3 customers_4 $5]
  $6 = 0    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6]
  loop {    [live at head: price_0 churn_1 market_2 signups_3 customers_4 $5 $6]
    if (>= $6 len($5)) {
      break    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6]
    }
    month_7 = $5[$6]    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 month_7]
    $6 = (+ $6 1)    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 month_7]
    new_8 ~ poisson(signups_3)    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 month_7 new_8]
    lost_9 ~ binomial(customers_4, churn_1)    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 month_7 new_8 lost_9]
    customers_4 = (+ customers_4 (- new_8 lost_9))    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 month_7]
    report (* customers_4 price_0) by month_7 as "MRR ($)"    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6]
    $10 = call fn#1 next_month(market_2)    [live: price_0 churn_1 signups_3 customers_4 $5 $6 $10]
    market_2 = $10    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6]
    $12 = market_2    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 $12]
    if (== $12 Market.Boom) {
      $11 = to(8%, 20%)    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 $11]
    } else {
      if (== $12 Market.Steady) {
        $11 = to(1%, 6%)    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 $11]
      } else {
        if (== $12 Market.Slump) {
          $11 = to((- 8%), 0%)    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 $11]
        } else {
          fail "no arm of this `match` matches the value of `market`"    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 $11]
        }
      }
    }
    growth_13 ~ $11    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6 growth_13]
    signups_3 = (* signups_3 (+ 1 growth_13))    [live: price_0 churn_1 market_2 signups_3 customers_4 $5 $6]
  }
  report (>= (* customers_4 price_0) 100000) as "MRR ≥ $100k after 18 months"    [live: ]
fn#1 next_month (m_0)
  $2 = m_0    [live: $2]
  if (== $2 Market.Boom) {
    chance (value) {
      70% => {
        $1 = Market.Boom    [live: $1]
      }
      25% => {
        $1 = Market.Steady    [live: $1]
      }
      else => {
        $1 = Market.Slump    [live: $1]
      }
    }
  } else {
    if (== $2 Market.Steady) {
      chance (value) {
        10% => {
          $1 = Market.Boom    [live: $1]
        }
        80% => {
          $1 = Market.Steady    [live: $1]
        }
        else => {
          $1 = Market.Slump    [live: $1]
        }
      }
    } else {
      if (== $2 Market.Slump) {
        chance (value) {
          5% => {
            $1 = Market.Boom    [live: $1]
          }
          35% => {
            $1 = Market.Steady    [live: $1]
          }
          else => {
            $1 = Market.Slump    [live: $1]
          }
        }
      } else {
        fail "no arm of this `match` matches the value of `m`"    [live: $1]
      }
    }
  }
  return $1    [live: ]
