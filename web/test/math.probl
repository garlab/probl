# Numerical and sampling parity between the native and WebAssembly engines.
@mode sample(runs: 1000, seed: 19)

report [pi, e, euler_gamma] as "constants"
report [exp(1) == e, exp(1) - e, e - exp(1), exp(complex(1)) == complex(e)] as "Euler constant consistency"
report [mean(lognormal(0.5, 1)) == e, exp(0.9999999999999998) < e, exp(1.0000000000000002) > e] as "exponential rounding"
report [sin(0.5), cos(0.5), tan(0.5)] as "trigonometry"
report [asin(-1), acos(-1), atan(0.5), atan2(1, -1), atan2(0, 0)] as "inverse angles"
report [atan2(-0.0, -1), atan2(0, -0.0)] as "signed zeros"
report [sinh(0.5), cosh(0.5), tanh(0.5)] as "hyperbolic"
report [asinh(-0.5), acosh(2), atanh(0.5)] as "inverse hyperbolic"
report [asinh(1e308), acosh(1e308), atanh(1e-300)] as "extreme inverse hyperbolic"
report [round(1.125, 2), round(-1.125, 2), round(1250, -2), round(1.5), round(1.5, 0)] as "rounding"
report [round(9007199254740993, -1), round(1.234e-310, 312), round(5e-324, 323), round(1e308, 2)] as "extreme rounding"
report round(one_of([1.125, 2.125]), d2) as "uncertain rounding"
report [log2(0.5), log1p(1e-20), expm1(1e-20)] as "logarithms and exponentials"
report [hypot(3e200, 4e200) / 1e200, hypot(3e-200, 4e-200) / 1e-200] as "scaled distances"
report [sin(1e300), cos(1e300), tan(1e300)] as "large angles"
report [choose(52, 5), choose(66, 33), factorial(20)] as "exact combinatorics"
report [gcd(-54, 24), lcm(21, -6), euler_phi(65537)] as "integer functions"
report [ln_gamma(0.5), ln_gamma(1000), erf(-1), erf(1e-20)] as "special functions"
report [erfc(-1), erfc(8), 1 - erf(8)] as "small tails"
report [cbrt(-8), cbrt(1e-300), exp2(0.5), exp2(-1074)] as "roots and powers"
report [trunc(-1.9), trunc(9007199254740993), trunc(-9.223372036854776e18)] as "truncation"
report erfc(one_of([-1, 1])) as "uncertain complements"
let z: complex = complex(3, 4)
report [z, z * conj(z), z / complex(1, -1), complex(0, 1)^-3] as "complex arithmetic"
report [real(z), imag(z), abs(z), abs2(z), arg(z)] as "complex components"
report [cis(pi / 2), arg(complex(-1, -0.0))] as "complex phase"
report complex(1e308, 1e308) / complex(1e308, 1e308) as "scaled complex division"
report one_of([complex(0, 1), complex(0, -1)]) as "classical complex mixture"
report mean(one_of([complex(1, 2), 3])) as "complex mean"
report [sqrt(complex(-1)), cbrt(complex(-8)), ln(complex(-1, -0.0)), ln(complex(-1, -1e-20))] as "principal roots and log"
report [exp(z), exp2(z), expm1(z), ln(z), log2(z), log10(z), log1p(z)] as "complex exponentials and logs"
report [sin(z), cos(z), tan(z), asin(z), acos(z), atan(z)] as "complex trigonometry"
report [sinh(z), cosh(z), tanh(z), asinh(z), acosh(z), atanh(z)] as "complex hyperbolic"
report [asin(complex(2)), acos(complex(-2)), atan(complex(0, -2)), asinh(complex(0, -2)), acosh(complex(-2)), atanh(complex(-2))] as "inverse cuts"
report [log1p(complex(1e-100, 1e-100)), expm1(complex(1e-100, 1e-100)), acos(complex(1, 1e-100))] as "complex cancellation"
report [sqrt(complex(1.7e308, 1.7e308)), ln(complex(1.7e308, 1.7e308)), exp(complex(710, pi/4)), tan(complex(1e308, 1e308))] as "complex extremes"
report [exp2(complex(-1074)), exp2(complex(-1075))] as "complex underflow"
report sqrt(one_of([complex(-4), complex(9)])) as "lifted principal roots"
report choose(d2 + 2, 2) as "uncertain selections"
report hypot(one_of([0: 25%, 3: 75%]), one_of([0, 4])) as "independent arguments"
let angle ~ uniform(-pi, pi)
report sin(angle) as "random angle"
report abs(sin(angle)^2 + cos(angle)^2 - 1) < 1e-12 as "one angle, two uses"

report [factorial(30), choose(100, 50), 10^100 + 1 - 10^100] as "large exact integers"
report [gcd(6 * 10^100, 9 * 10^100), lcm(6 * 10^100, 9 * 10^100), euler_phi(2^100)] as "large integer functions"
report [(10^400) / (10^400), 9007199254740993 > 9007199254740992.0, round(10^100 + 15, -1)] as "integer precision boundaries"
report [len(0..10^100), (10^100..10^100 + 2)[1], complex(0, 1)^(10^400 + 1)] as "large indices and exponents"
report one_of([10^400, 10^400 + 1]) as "large integer outcomes"
