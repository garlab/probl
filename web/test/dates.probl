# Calendar behavior must be identical in the native engine and WebAssembly.
report today
report today == simulate { let n ~ d6; today + n - n }
report date(2024, 2, 29) == '2024-02-29'
report '0001-01-01'.weekday()
report '9999-12-31'.end_of_month()
report '1969-12-31' + days(1)
report '2024-03-01' - '2024-02-28'
let elapsed: duration = '2024-03-01' - '2024-02-28'
report [typeof elapsed, elapsed, elapsed / '1d']
report '2024-02-28' - '2024-03-01'
report '2024-02-28' - '2024-02-28'
report '9999-12-31' - '0001-01-01'
report one_of(['2024-02-28', '2024-03-01']) - '2024-02-28'
report '2024-01-31'.add_months(one_of([-1, 1, 2]))
report '2024-02-29'.add_years(one_of([1, 4]))
report date(2024, 2, one_of([28, 29]))
report '2024-02-29'.year()
report '2024-02-29'.month()
report '2024-02-29'.day()
report '2024-02-29'.start_of_month()
let holidays = ['2026-10-05', '2026-10-02', '2026-10-02', '2026-10-03']
report '2026-10-01'.add_workdays(1, holidays)
report '2026-10-06'.add_workdays(-1, holidays)
report '2026-10-02'.is_workday(holidays)
report '2026-10-03'.add_workdays(0)
report '2000-01-03'.add_workdays(1_000_000)
