# Runtime type inspection does not draw from distributions.
enum State { On, Off }
type Box = { value: int }
report [typeof 33%, typeof 0.33, typeof (33% + 1%), typeof 150%, typeof (-33%)]
report [typeof true, typeof (2^100), typeof complex(0, 1), typeof today]
report [typeof d6, typeof (d6 > d6), typeof normal(0, 1), typeof (x -> x)]
report [typeof [d6, d8], typeof roll(2, d6), typeof [], typeof [1, 2.0]]
report [typeof [:], typeof ["a": 1], typeof bag([1: 2])]
report [typeof On, typeof one_of([On, Off]), typeof Box { value: 1 }]
report typeof { b: d6, a: 1 }
report typeof one_of([normal(0, 1), 1.0])
let x ~ d6
report typeof x == "int"
var calls = 0
let kind = typeof { calls += 1; d6 }
report [kind, calls]

# Checked probabilities, contextual literals, arithmetic and observations.
let p: prob = 33%
report [typeof p, typeof prob(33%), typeof prob(true), typeof (p * p)]
fn probability_kind(p: prob) { typeof p }
report probability_kind(33%)
let probabilities: list[prob] = [0, 33%, 1]
report typeof probabilities
report simulate { let event ~ bernoulli(5%); observe event; event }
report chance { p => true, else => false }

# Probabilistic branching, prefix draws and likelihood weights.
report if 30% { "rain" } else { "sun" }
report simulate { var rolls = 0; while ~d6 != 6 { rolls += 1 }; rolls }
report simulate { let sick = ~bernoulli(1%); score if sick { 95% } else { 8% }; sick }
report simulate { let event = ~p; observe event; event }
report simulate { observe ~p; true }
report [typeof (p and p), typeof (not p), typeof ((d6 > 3) and (d6 > 3))]
report (d6 > 3) and (d6 > 3)

# Bag extraction returns an item unchanged; drawing it is a separate operation.
var rates = bag([prob(25%), prob(75%)])
let selected = rates.take()
report [typeof selected, selected, len(rates)]
report simulate { var rates = bag([prob(25%), prob(75%)]); observe ~rates.take(); rates.take() }
var recipes = bag([d2, d4])
let recipe = recipes.take()
report [typeof recipe, mean(recipe), len(recipes)]
let drawn = ~recipes.take()
report [typeof drawn, drawn, len(recipes)]
var ordered = bag([1, 2])
report [len(ordered), ordered.take(), len(ordered), ordered.take(), len(ordered)]
